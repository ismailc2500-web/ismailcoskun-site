# ─────────────────────────────────────────────────────────────────────────────
# Fruit Saga Studio — environment
# Copy to .env and fill in only what you use. Everything works with no keys at
# all while MOCK_MODE=true (placeholder art, animatic video, placeholder voice).
# ─────────────────────────────────────────────────────────────────────────────

# ---- Core -------------------------------------------------------------------
# true  = never call a paid API (safe default; the whole pipeline still renders)
# false = use the providers below (Settings → Providers can override per mode)
MOCK_MODE=true

# Quality of new episodes: preview (540x960, cheap/fast) | final (1080x1920)
DEFAULT_RENDER_MODE=preview

# Storage (relative to this folder). Keep media on another disk if you like.
DATA_DIR=./data
OUTPUT_DIR=./output
CACHE_DIR=./cache
# DATABASE_PATH=./data/studio.db

# FFmpeg 6+ with libass, libx264 (see README → FFmpeg)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Provider selection (ignored while MOCK_MODE=true) -----------------------
LLM_PROVIDER=openai            # mock | openai | anthropic | ollama
IMAGE_PROVIDER=openai          # mock | openai | stability
VIDEO_PROVIDER=runway          # mock | runway | luma | kling | veo
TTS_PROVIDER=openai            # mock | openai | elevenlabs | local

# Preview-mode overrides (empty = same as above). The default preview video
# provider is the free "animatic" (camera moves on keyframes) → $0 per preview.
PREVIEW_VIDEO_PROVIDER=mock
PREVIEW_IMAGE_PROVIDER=
PREVIEW_TTS_PROVIDER=

# ---- OpenAI (LLM, images, TTS) ------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_PREVIEW_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

# ---- Anthropic (LLM) ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Ollama (free local LLM: `ollama pull llama3.1`) ---------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Stability AI (images) --------------------------------------------------------
STABILITY_API_KEY=
STABILITY_MODEL=core            # core | ultra | sd3.5-large …

# ---- Runway (image-to-video) --------------------------------------------------
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo
RUNWAY_API_VERSION=2024-11-06

# ---- Luma Dream Machine (video) ---------------------------------------------------
LUMA_API_KEY=
LUMA_MODEL=ray-2
LUMA_PREVIEW_MODEL=ray-flash-2
# Luma needs a public URL for keyframes: a tunnel to this app, e.g. https://abc.ngrok.app
PUBLIC_ASSET_BASE_URL=

# ---- Kling (video) ---------------------------------------------------------------------
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-1

# ---- Google Veo via the Gemini API (video) ----------------------------------------
GEMINI_API_KEY=
VEO_MODEL=veo-3.0-fast-generate-001

# ---- ElevenLabs (TTS with exact word timestamps) ------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_NARRATOR_VOICE_ID=

# ---- Local TTS (free): placeholders {text} {text_file} {output} {voice} --------
# Auto-detects `say` (macOS) or espeak-ng when empty.
# LOCAL_TTS_COMMAND=espeak-ng -v en-gb -s 150 -w {output} {text}
# LOCAL_TTS_COMMAND=piper --model en_GB-alan-medium.onnx --output_file {output} --input_file {text_file}
# Kokoro (free neural voices, see README → "Free neural narration"):
# LOCAL_TTS_COMMAND=/home/you/.venvs/kokoro/bin/python scripts/tts/kokoro_tts.py --voice={voice} --text-file {text_file} --output {output}
LOCAL_TTS_COMMAND=

# ---- Cost control ---------------------------------------------------------------------
# A run whose *uncached* estimate exceeds this asks for confirmation first.
MAX_EPISODE_BUDGET_USD=5
IMAGE_QUALITY_PREVIEW=low
IMAGE_QUALITY_FINAL=high
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=2000
GENERATION_CONCURRENCY=2

# ---- Look & feel -----------------------------------------------------------------------
# Caption font (must be installed, or drop a .ttf/.otf into assets/fonts/)
SUBTITLE_FONT=Arial
# Small debug label on mock keyframes
MOCK_LABELS=true
# Testing aid: prompts matching this regex fail in the mock image provider
# MOCK_FAIL_PATTERN=KEYFRAME · s03
